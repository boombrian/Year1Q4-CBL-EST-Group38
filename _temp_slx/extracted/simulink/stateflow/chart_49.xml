      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [PtoInjection, PfromExtraction, PSell, PBuy] = controller(PtoController, PfromController, EStorage, EStrorageMax, EStrorageMin)
    
    %% Power surplus or deficit

    deltaP = PtoController - PfromController;

    % Power surplus
    if deltaP &gt;= 0

        %% Storage injection

        % Storage system is not full
        if EStorage &lt; EStrorageMax 

            PtoInjection = deltaP;

        % Storage system is full
        else
            PtoInjection = 0;
        end

        %% Storage extraction

        PfromExtraction = 0;

        %% Load-balancing
        PSell   = deltaP - PtoInjection;
        PBuy    = 0;

    % Power deficit
    else

        %% Storage injection

        PtoInjection = 0;

        %% Storage extraction

        % Storage system is not empty
        if EStorage &gt; EStrorageMin

            PfromExtraction = -deltaP;

        % Storage system is empty
        else
            PfromExtraction = 0;
        end

        %% Load-balancing

        PSell = 0;
        PBuy  = -deltaP - PfromExtraction;
    end</P>
      </eml>
    </state>
