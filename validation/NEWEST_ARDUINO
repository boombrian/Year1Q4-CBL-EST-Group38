// Pin definitions based on wiring 
const int P2_PIN = A0; // Pressure sensor 2 [cite: 1, 2]
const int Q_PIN  = A1; // Air flow sensor [cite: 2, 3]   

// Constants for ADC conversion
const float VREF = 5.0;
const int ADC_MAX = 1023;

// === SOFTWARE SAFETY SETTINGS ===
// 0.5 MPa converts to 5.0 bar
const float MAX_SAFE_PRESSURE = 5.0; // Max allowed pressure in bar [cite: 6]
const unsigned long MAX_OVERPRESSURE_TIME = 2000; // Allowed spike duration in milliseconds (2 seconds) [cite: 7]

unsigned long overpressureStartTime = 0; 
bool safetyTripped = false;

void setup() {
  Serial.begin(9600);
  
  // CSV file header (Updated column names to reflect 'bar')
  Serial.println("time_s,V_P2,V_Q,P2_bar,Q_L_min");
}

// Conversion of raw ADC to voltage
float readVoltage(int pin) {
  int raw = analogRead(pin); 
  float voltage = raw * (VREF / (float)ADC_MAX); 
  return voltage;
}

// PSE570-02: 1V to 5V maps to 0 to 10 bar (Originally 0 to 1 MPa)
float pressureBar(float voltage) {
  // (voltage - 1.0) / 4.0 gives 0 to 1 MPa. Multiplying by 10 converts it to bar.
  float pressure = ((voltage - 1.0) / 4.0) * 10.0; 
  if (pressure < 0) pressure = 0; // Grounding floor for noise 
  return pressure;
}

// PF2A521-F03-1: 1V to 5V maps to 0 to 100 L/min
float flowLmin(float voltage) {
  float flow = 45.0 * voltage - 25.0; 
  if (flow < 0) flow = 0;
  return flow;
}

void loop() {
  // Timestamp
  float time_s = millis() / 1000.0;

  // Read voltages
  float V_P2 = readVoltage(P2_PIN);
  float V_Q  = readVoltage(Q_PIN);

  // Convert to engineering units (Updated to Bar)
  float P2_bar = pressureBar(V_P2);
  float Q_L_min = flowLmin(V_Q); 

  // === SOFTWARE SAFETY CHECK ===
  // Check if pressure sensor exceeds the maximum safe limit (now in bar)
  if (P2_bar > MAX_SAFE_PRESSURE) { 
    if (overpressureStartTime == 0) {
      overpressureStartTime = millis(); // Start timing the spike [cite: 17, 18]
    }
    
    // If the pressure stays too high for longer than allowed, trip the safety
    if ((millis() - overpressureStartTime) > MAX_OVERPRESSURE_TIME) {
      safetyTripped = true;
    }
  } else {
    overpressureStartTime = 0; // Reset timer if pressure drops back to normal [cite: 19, 20]
  }

  // Output in CSV format
  Serial.print(time_s, 3); 
  Serial.print(",");
  
  Serial.print(V_P2, 3);
  Serial.print(",");
  Serial.print(V_Q, 3);
  Serial.print(",");
  
  Serial.print(P2_bar, 4);
  Serial.print(",");
  Serial.println(Q_L_min, 2);

  // Append safety status string so MATLAB can read it
  if (safetyTripped) { 
    Serial.println("CRITICAL_OVERPRESSURE");
  } else { 
    Serial.println("NORMAL");
  }
  
  delay(10); // 1Hz sample frequency (Note: delay(10) is actually ~100Hz, update to delay(1000) if 1Hz is strictly desired)
}
